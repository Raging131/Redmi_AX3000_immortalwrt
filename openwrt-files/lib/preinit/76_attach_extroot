# Attach the spare "overlay" mtd as UBI before mount_root evaluates extroot,
# so /dev/ubi1_0 exists for the is_rootfs entry in /etc/config/fstab.
# Pure shell field splitting - no sed/awk escaping pitfalls.
attach_extroot_volume() {
	local idx line
	[ -e /dev/ubi1_0 ] && return 0
	line=$(grep '"overlay"' /proc/mtd | head -n1)
	[ -n "$line" ] || return 0
	idx=${line#mtd}
	idx=${idx%%:*}
	[ -n "$idx" ] || return 0
	ubiattach -m "$idx" >/dev/null 2>&1
}
boot_hook_add preinit_essential attach_extroot_volume
